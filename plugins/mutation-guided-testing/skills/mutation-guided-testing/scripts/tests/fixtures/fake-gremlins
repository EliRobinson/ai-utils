#!/usr/bin/env python3
"""Stands in for `gremlins unleash` in the go_mutate.sh tests.

Appends what it was called with to $FAKE_LOG (one JSON line: argv, cwd,
GOFLAGS, the go.mod it would build) and copies $FAKE_REPORT to the -o path.
"""
import json
import os
import shutil
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    with open("go.mod") as f:
        gomod = f.read()
    log.write(json.dumps({"argv": args, "cwd": os.getcwd(),
                          "goflags": os.environ.get("GOFLAGS", ""), "gomod": gomod}) + "\n")
shutil.copy(os.environ["FAKE_REPORT"], args[args.index("-o") + 1])
